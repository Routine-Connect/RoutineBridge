<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.routinebridge.dev.routinebridge.mapper.RoutineMapper">

    <resultMap id="RoutineResultMap" type="com.routinebridge.dev.routinebridge.domain.Routine">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="title" column="title"/>
        <result property="daysOfWeek" column="days_of_week"/>
        <result property="alarmTime" column="alarm_time"/>
        <result property="isActive" column="is_active"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByUserId" resultType="com.routinebridge.dev.routinebridge.domain.Routine">
        SELECT * FROM Routines WHERE user_id = #{userId}
    </select>

    <select id="findById" resultType="com.routinebridge.dev.routinebridge.domain.Routine">
        SELECT * FROM Routines WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO Routines (user_id, title, days_of_week, alarm_time, is_active)
        VALUES (#{userId}, #{title}, #{daysOfWeek}, #{alarmTime}, #{isActive})
    </insert>

    <update id="update">
        UPDATE Routines
        SET title = #{title}, days_of_week = #{daysOfWeek},
            alarm_time = #{alarmTime}, is_active = #{isActive}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM Routines WHERE id = #{id}
    </delete>

    <select id="findTodayRoutines" resultType="com.routinebridge.dev.routinebridge.domain.Routine">
        SELECT * FROM Routines
        WHERE user_id = #{userId}
          AND is_active = TRUE
          AND FIND_IN_SET(#{dayOfWeek}, days_of_week) > 0
    </select>

</mapper>