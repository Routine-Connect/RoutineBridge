<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.routinebridge.dev.routinebridge.mapper.UserMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO Users (email, password, nickname, gender)
        VALUES (#{email}, #{password}, #{nickname}, #{gender})
    </insert>

    <select id="findByEmail" resultType="com.routinebridge.dev.routinebridge.domain.User">
        SELECT * FROM Users WHERE email = #{email}
    </select>

    <select id="findById" resultType="com.routinebridge.dev.routinebridge.domain.User">
        SELECT * FROM Users WHERE id = #{id}
    </select>

    <update id="update">
        UPDATE Users
        SET nickname = #{nickname}, password = #{password}
        WHERE id = #{id}
    </update>

</mapper>