<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doday.dev.doday.mapper.ShareTokenMapper">

    <select id="findByUserId" resultType="com.doday.dev.doday.domain.ShareToken">
        SELECT * FROM ShareTokens WHERE user_id = #{userId}
    </select>

    <select id="findByToken" resultType="com.doday.dev.doday.domain.ShareToken">
        SELECT * FROM ShareTokens WHERE token = #{token}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ShareTokens (user_id, token)
        VALUES (#{userId}, #{token})
    </insert>

    <update id="update">
        UPDATE ShareTokens
        SET token = #{token}
        WHERE user_id = #{userId}
    </update>

</mapper>